# Development only. Packaged production builds should pin Khepree endpoints.
KHEPREE_API_BASE=https://api.khepree.com/api/v1
KHEPREE_ACCOUNT_BASE=https://account.khepree.com
KHEPREE_WEBSITE=https://khepree.com

# Must match the desktop client/product registered in Khepree.
KHEPREE_CLIENT_ID=khepree-livestream-ai-desktop
KHEPREE_PRODUCT_SLUG=khepree-livestream-ai
KHEPREE_LICENSE_SIGNING_PUBLIC_KEY=
KHEPREE_LICENSE_SIGNING_KEY_ID=k1

# Enables local mock license only in unpackaged development.
KHEPREE_DEV_MOCK=1

# Python executable. Packaged builds should bundle/pin a runtime later.
KHEPREE_PYTHON=python

# Worker startup behaviour.
KHEPREE_WORKER_STARTUP_TIMEOUT_MS=20000
