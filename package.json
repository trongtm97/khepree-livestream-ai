{
  "name": "khepree-livestream-ai",
  "productName": "Khepree Livestream AI",
  "version": "0.1.0",
  "description": "Human-supervised AI livestream commerce desktop platform",
  "main": ".vite/build/main.js",
  "private": true,
  "license": "UNLICENSED",
  "protocols": [
    {
      "name": "Khepree Livestream AI",
      "schemes": ["khepreelivestreamai"]
    }
  ],
  "scripts": {
    "start": "electron-forge start",
    "dev": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit",
    "test:foundation": "node scripts/foundation-check.mjs",
    "test:multi-live": "npx --yes tsx src/main/db/multi-live-self-check.ts",
    "test:live-runtime": "npx --yes tsx src/main/live/live-runtime-self-check.ts",
    "test:multi-live-manager": "npx --yes tsx src/main/live/multi-live-manager-self-check.ts",
    "test:account-aware-ipc": "npx --yes tsx src/main/ipc/account-aware-ipc-self-check.ts",
    "test:sales-brain": "npx --yes tsx src/shared/sales-brain/self-check.ts",
    "doctor": "node scripts/dev-doctor.mjs",
    "worker:gemini": "python workers/gemini_worker/app.py",
    "worker:tiktok": "python workers/tiktok_worker/app.py"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^0.468.0",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.5.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
